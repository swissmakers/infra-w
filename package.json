  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-ws": "^5.0.2",
    "joi": "^18.2.9",
    "ldapts": "^9.2.0",
    "openid-client": "^6.8.8",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "speakeasy": "^2.0.0",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "uuid": "^14.0.2",
    "webdav": "^5.11.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "9.39.5",
    "express-jsdoc-swagger": "^1.8.0",
    "globals": "17.12.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.63.0",
    "vitepress": "^1.6.4",
    "vitepress-openapi": "^0.2.5"
  },
  "scripts": {
    "dev:server": "nodemon --ignore docs --ignore vendor --ignore client --ignore data --exec \"node --env-file-if-exists=.env\" server/index.js",
    "dev:client": "cd client && yarn run dev",
    "dev:guacd": "./scripts/build-guacd.sh",
    "dev": "concurrently --kill-others-on-fail \"yarn dev:server\" \"yarn dev:client -- --host\" \"yarn dev:guacd\"",
    "build": "cd client && yarn build",
    "lint": "eslint server tests scripts eslint.config.js && cd client && yarn lint",
    "docs:openapi": "node scripts/generate-openapi.js",
    "docs:dev": "yarn docs:openapi && vitepress dev docs",
    "docs:build": "yarn docs:openapi && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "security:update": "./scripts/ci-security.sh update",
    "security:audit": "./scripts/ci-security.sh audit",
    "security:all": "./scripts/ci-security.sh all",
    "security:sbom": "SECURITY_GENERATE_SBOM=1 ./scripts/ci-security.sh audit",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/browser-smoke.cjs",
    "screenshots": "node scripts/screenshots.cjs"
  },
  "resolutions": {
    "tar": "^7.5.22",
    "@tootallnate/once": "^3.0.1",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "minimatch": "^10.2.6",
    "qs": "^6.16.0",
    "lodash": "^4.18.1",
    "dottie": "^2.0.7",
    "fast-xml-parser": "^5.11.1",
    "brace-expansion": "^5.0.12",
    "express/path-to-regexp": "0.1.13",
    "router/path-to-regexp": "8.4.2",
    "vitepress/vite": "^6.4.3",
    "sequelize/uuid": "^11.1.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
